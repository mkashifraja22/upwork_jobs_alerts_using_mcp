# --- Upwork ---
# No token needed: run the app, open the dashboard and click "Connect Upwork".
UPWORK_MCP_URL=https://mcp.upwork.com/mcp
# Optional: leave empty to auto-detect your Freelancer account
UPWORK_ORG_UID=

# --- Web dashboard ---
PORT=5050
# URL your browser uses to reach the app (Upwork redirects back to PUBLIC_URL/oauth/callback)
PUBLIC_URL=http://localhost:5050

# NOTE: everything below is only the *starting default*. Keywords, filters, email and
# schedule are edited in the dashboard and saved in jobs.db, which then takes over.

# --- What to watch (comma-separated; each is a separate Upwork search) ---
JOB_SEARCHES=Django,FastAPI,Python backend,REST API,HubSpot,Salesforce integration,Zoho,RAG,LangChain

# --- Polling & filters ---
# Minimum 300 (enforced). 600 = every 10 min — light, account-safe usage.
POLL_SECONDS=600
# Pause between individual searches in one check
SEARCH_DELAY_SECONDS=3
MAX_AGE_HOURS=24
VERIFIED_PAYMENT_ONLY=false
MIN_CLIENT_SPEND=0
# false = on first launch, existing jobs are saved silently (no email flood)
EMAIL_ON_FIRST_RUN=false

# --- SMTP (Gmail: use an App Password, not your normal password) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASS=your_16_char_app_password
MAIL_FROM=
MAIL_TO=you@gmail.com
